#: src/grubconfighelper.cpp:70
msgid "The input file was not generated by Miryu GRUB2 Boot Config."
msgstr "Die Eingabedatei wurde nicht von Miryu GRUB2 Boot Config generiert."

#: src/grubconfighelper.cpp:102
msgid "GRUB_TIMEOUT must be between -1 and 3600."
msgstr "GRUB_TIMEOUT muss zwischen -1 und 3600 liegen."

#: src/grubconfighelper.cpp:131
msgid "Unsupported or unsafe configuration line: %1"
msgstr "Nicht unterstützte oder unsichere Konfigurationszeile: %1"

#: src/grubconfighelper.cpp:136
msgid "The configuration is incomplete."
msgstr "Die Konfiguration ist unvollständig."

#: src/grubconfighelper.cpp:212
msgid "Could not open %1 for writing."
msgstr "%1 konnte nicht zum Schreiben geöffnet werden."

#: src/grubconfighelper.cpp:218
msgid "Could not atomically replace %1."
msgstr "%1 konnte nicht atomar ersetzt werden."

#: src/grubconfighelper.cpp:236
msgid "Warning: could not remove the old drop-in file %1."
msgstr "Warnung: Die alte Drop-in-Datei %1 konnte nicht entfernt werden."

#: src/grubconfighelper.cpp:282
msgid "Could not apply new kernel parameters to BLS entries."
msgstr ""
"Neue Kernel-Parameter konnten nicht auf BLS-Einträge angewendet werden."

#: src/grubconfighelper.cpp:293
msgid "Could not remove old kernel parameters from BLS entries."
msgstr ""
"Alte Kernel-Parameter konnten nicht aus BLS-Einträgen entfernt werden."

#: src/grubconfighelper.cpp:329
msgid "grub2-mkconfig timed out."
msgstr "Zeitüberschreitung bei grub2-mkconfig."

#: src/grubconfighelper.cpp:339
msgid "grub2-mkconfig failed."
msgstr "grub2-mkconfig fehlgeschlagen."

# Helper messages
#: src/grubconfighelper.cpp:357
msgid ""
"Usage: miryu-toolkit-grub-config-helper --apply <generated-config-file>"
msgstr ""
"Verwendung: miryu-toolkit-grub-config-helper --apply <generierte-"
"Konfigurationsdatei>"

#: src/grubconfighelper.cpp:362
msgid "This helper must run as root through polkit."
msgstr "Dieses Hilfsprogramm muss als Root über polkit ausgeführt werden."

#: src/grubconfighelper.cpp:368
msgid "Reading configuration file..."
msgstr "Konfigurationsdatei wird gelesen..."

#: src/grubconfighelper.cpp:373
msgid "Could not read the generated configuration file."
msgstr "Die generierte Konfigurationsdatei konnte nicht gelesen werden."

#: src/grubconfighelper.cpp:377
msgid "Parsing configuration..."
msgstr "Konfiguration wird geparst..."

#: src/grubconfighelper.cpp:386
msgid "Reading existing %1..."
msgstr "Vorhandene %1 wird gelesen..."

#: src/grubconfighelper.cpp:400
msgid "Writing %1..."
msgstr "%1 wird geschrieben..."

#: src/grubconfighelper.cpp:413
msgid "Updating BLS entries..."
msgstr "BLS-Einträge werden aktualisiert..."

#: src/grubconfighelper.cpp:422
msgid "Regenerating GRUB configuration..."
msgstr "GRUB-Konfiguration wird neu erstellt..."

#: src/grubconfighelper.cpp:430
msgid "GRUB2 configuration updated."
msgstr "GRUB2-Konfiguration aktualisiert."

#: src/main.cpp:14 src/mainwindow.cpp:68 src/mainwindow.cpp:106
#: src/mainwindow.cpp:1351 kcm/kcm_miryu_toolkit.cpp:41
msgid "Miryu Toolkit"
msgstr "Miryu Werkzeugkasten"

#: src/main.cpp:16
msgid "Miryu system utility toolkit"
msgstr "Miryu Systemwerkzeugkasten"

#: src/main.cpp:18
msgid "(c) 2026 Miryu"
msgstr "(c) 2026 Miryu"

#: src/mainwindow.cpp:75
msgid ""
"Manage Miryu components, maintenance tasks, system-wide environment "
"variables and sleep settings in one place."
msgstr ""
"Verwalten Sie Miryu-Komponenten, Wartungsaufgaben, systemweite "
"Umgebungsvariablen und Energieverwaltungseinstellungen an einem Ort."

#: src/mainwindow.cpp:89 src/mainwindow.cpp:185
msgid "Miryu System Assistant"
msgstr "Miryu System-Assistent"

#: src/mainwindow.cpp:90 src/mainwindow.cpp:1589
msgid "Boot Menu"
msgstr "Startmenü"

#: src/mainwindow.cpp:91
msgid "System-wide environment variables"
msgstr "Systemweite Umgebungsvariablen"

#: src/mainwindow.cpp:92
msgid "Sleep"
msgstr "Energieverwaltung"

#: src/mainwindow.cpp:93
msgid "Install additional components"
msgstr "Zusätzliche Komponenten installieren"

#: src/mainwindow.cpp:94
msgid "About"
msgstr "Über"

#: src/mainwindow.cpp:98
msgid "Ready"
msgstr "Bereit"

#: src/mainwindow.cpp:119
msgid "Install Fedora official kernel"
msgstr "Offiziellen Fedora-Kernel installieren"

#: src/mainwindow.cpp:120
msgid ""
"If some games' anti-cheat systems use Epic EAC Linux v2 and cannot start, "
"you can install the Fedora official kernel to solve the problem."
msgstr ""
"Wenn die Anti-Cheat-Systeme einiger Spiele Epic EAC Linux v2 verwenden und "
"nicht starten können, können Sie den offiziellen Fedora-Kernel installieren,"
" um das Problem zu beheben."

#: src/mainwindow.cpp:133
msgid "Install Wine"
msgstr "Wine installieren"

#: src/mainwindow.cpp:134
msgid ""
"Install Wine, DXVK, Winetricks and WineASIO for running Windows programs and"
" some audio workflows."
msgstr ""
"Wine, DXVK, Winetricks und WineASIO zum Ausführen von Windows-Programmen und"
" einigen Audio-Arbeitsabläufen installieren."

#: src/mainwindow.cpp:147
msgid "Install Steam"
msgstr "Steam installieren"

#: src/mainwindow.cpp:148
msgid ""
"Install the Steam client. Steam will download update files on first launch."
msgstr ""
"Den Steam-Client installieren. Steam lädt beim ersten Start "
"Aktualisierungsdateien herunter."

#: src/mainwindow.cpp:155
msgid "Install MIDI playback support"
msgstr "MIDI-Wiedergabeunterstützung installieren"

#: src/mainwindow.cpp:156
msgid ""
"Install the FluidSynth GStreamer plugin to enable MIDI file playback "
"support."
msgstr ""
"Das FluidSynth-GStreamer-Plugin installieren, um die Wiedergabe von MIDI-"
"Dateien zu ermöglichen."

#: src/mainwindow.cpp:163
msgid "Install additional fonts"
msgstr "Zusätzliche Schriften installieren"

#: src/mainwindow.cpp:164
msgid ""
"Install Noto Sans, Noto Serif, monospace and CJK supplemental fonts to "
"improve multilingual display."
msgstr ""
"Noto Sans, Noto Serif, Monospace- und CJK-Zusatzschriften installieren, um "
"die mehrsprachige Darstellung zu verbessern."

#: src/mainwindow.cpp:189 src/mainwindow.cpp:2298
msgid "Clean up previous kernel"
msgstr "Vorherige Kernel-Version bereinigen"

#: src/mainwindow.cpp:194 src/mainwindow.cpp:2678
msgid "Update system"
msgstr "System aktualisieren"

#: src/mainwindow.cpp:199
msgid "List failed systemd service units"
msgstr "Fehlgeschlagene systemd-Service-Units auflisten"

#: src/mainwindow.cpp:204 src/mainwindow.cpp:2965
msgid "Unlock RPM database"
msgstr "RPM-Datenbank entsperren"

#: src/mainwindow.cpp:209
msgid "View dnf5 log"
msgstr "dnf5-Protokoll anzeigen"

#: src/mainwindow.cpp:214
msgid "Clean unused packages (dnf5 autoremove)"
msgstr "Nicht verwendete Pakete bereinigen (dnf5 autoremove)"

#: src/mainwindow.cpp:219
msgid "View software crash information"
msgstr "Software-Absturzinformationen anzeigen"

#: src/mainwindow.cpp:224
msgid "Collect system logs"
msgstr "Systemprotokolle sammeln"

#: src/mainwindow.cpp:242
msgid "Additional components"
msgstr "Zusätzliche Komponenten"

#: src/mainwindow.cpp:250
msgid "Refresh status"
msgstr "Status aktualisieren"

#: src/mainwindow.cpp:275
msgid "Status: checking"
msgstr "Status: wird geprüft"

#: src/mainwindow.cpp:285
msgid "Packages: %1"
msgstr "Pakete: %1"

#: src/mainwindow.cpp:292 src/mainwindow.cpp:1453
msgid "Install"
msgstr "Installieren"

#: src/mainwindow.cpp:293 src/mainwindow.cpp:1453
msgid "Uninstall"
msgstr "Deinstallieren"

#: src/mainwindow.cpp:318
msgid "Environment variables"
msgstr "Umgebungsvariablen"

#: src/mainwindow.cpp:321
msgid ""
"Set system-wide environment variables using the NAME=VALUE format. Changes "
"are written to /etc/environment and take effect after logging in again."
msgstr ""
"Systemweite Umgebungsvariablen im Format NAME=WERT festlegen. Änderungen "
"werden nach /etc/environment geschrieben und nach erneuter Anmeldung "
"wirksam."

#: src/mainwindow.cpp:331 src/mainwindow.cpp:1650
msgid "Edit"
msgstr "Bearbeiten"

#: src/mainwindow.cpp:333
msgid "Reload"
msgstr "Neu laden"

#: src/mainwindow.cpp:334 src/mainwindow.cpp:2195 src/mainwindow.cpp:2196
msgid "Restore defaults"
msgstr "Standardwerte wiederherstellen"

#: src/mainwindow.cpp:335
msgid "Apply"
msgstr "Anwenden"

#: src/mainwindow.cpp:345
msgid "Log out and log back in for changes to take effect."
msgstr ""
"Melden Sie sich ab und wieder an, damit die Änderungen wirksam werden."

#: src/mainwindow.cpp:381
msgid "Allowed sleep modes"
msgstr "Erlaubte Energieverwaltungszustände"

#: src/mainwindow.cpp:385
msgid "Choose the sleep modes you want to allow."
msgstr ""
"Wählen Sie die Energieverwaltungszustände aus, die Sie erlauben möchten."

#: src/mainwindow.cpp:410 src/mainwindow.cpp:701 src/mainwindow.cpp:711
#: src/mainwindow.cpp:714 src/mainwindow.cpp:1180
msgid "Suspend"
msgstr "Bereitschaft"

#: src/mainwindow.cpp:411
msgid ""
"Keeps the session in memory (RAM). The computer is still running but uses "
"only a bit of power."
msgstr ""
"Hält die Sitzung im Arbeitsspeicher (RAM). Der Computer läuft weiter, "
"verbraucht aber nur wenig Strom."

#: src/mainwindow.cpp:414 src/mainwindow.cpp:1183
msgid "Hibernate"
msgstr "Ruhezustand"

#: src/mainwindow.cpp:415
msgid "Saves the session to disk (Swap). Shuts down the computer."
msgstr ""
"Speichert die Sitzung auf der Festplatte (Swap). Der Computer wird "
"heruntergefahren."

#: src/mainwindow.cpp:418
msgid "Suspend then hibernate"
msgstr "Bereitschaft, dann Ruhezustand"

#: src/mainwindow.cpp:419
msgid ""
"Suspends for a while (systemd decides how long, based on battery power), "
"then hibernates."
msgstr ""
"Wechselt für eine Weile in den Bereitschaftsmodus (systemd entscheidet "
"anhand der Batterieladung, wie lange), geht dann in den Ruhezustand."

#: src/mainwindow.cpp:422
msgid "Hybrid sleep"
msgstr "Hybrider Standbymodus"

#: src/mainwindow.cpp:423
msgid "Suspends but also saves the session to disk (Swap)."
msgstr ""
"Wechselt in den Bereitschaftsmodus, speichert die Sitzung aber auch auf der "
"Festplatte (Swap)."

#: src/mainwindow.cpp:429
msgid "Suspend method"
msgstr "Bereitschaftsmethode"

#: src/mainwindow.cpp:432
msgid ""
"This is the method used to suspend the computer. Only the methods offered by"
" your BIOS/firmware can be chosen."
msgstr ""
"Dies ist die Methode, mit der der Computer in den Bereitschaftsmodus "
"versetzt wird. Es können nur die von Ihrem BIOS/Ihrer Firmware angebotenen "
"Methoden gewählt werden."

#: src/mainwindow.cpp:446
msgid "Hibernation method"
msgstr "Ruhezustandsmethode"

#: src/mainwindow.cpp:449
msgid "This is the method used to power off the computer during hibernation."
msgstr ""
"Dies ist die Methode, mit der der Computer während des Ruhezustands "
"ausgeschaltet wird."

#: src/mainwindow.cpp:463
msgid "Detected problems"
msgstr "Erkannte Probleme"

#: src/mainwindow.cpp:465
msgid "Fix the detected problems to make your allowed sleep modes available."
msgstr ""
"Beheben Sie die erkannten Probleme, damit Ihre erlaubten "
"Energieverwaltungszustände verfügbar sind."

#: src/mainwindow.cpp:475 src/mainwindow.cpp:1293 src/mainwindow.cpp:1314
msgid "Fix detected problems"
msgstr "Erkannte Probleme beheben"

#: src/mainwindow.cpp:484
msgid "Available sleep modes"
msgstr "Verfügbare Energieverwaltungszustände"

#: src/mainwindow.cpp:486
msgid "These are the sleep modes systemd reports as available right now."
msgstr ""
"Dies sind die Energieverwaltungszustände, die systemd derzeit als verfügbar "
"meldet."

#: src/mainwindow.cpp:499 src/mainwindow.cpp:1689
msgid "Saving requires administrator authentication through polkit."
msgstr ""
"Zum Speichern ist eine Administrator-Authentifizierung über polkit "
"erforderlich."

#: src/mainwindow.cpp:501
msgid "Apply sleep settings"
msgstr "Energieverwaltungseinstellungen anwenden"

#: src/mainwindow.cpp:550 src/mainwindow.cpp:586
msgid "Default"
msgstr "Standard"

#: src/mainwindow.cpp:561 src/mainwindow.cpp:705
msgid "Suspend-to-idle (s2idle)"
msgstr "Bereitschaft bis Leerlauf (s2idle)"

#: src/mainwindow.cpp:563 src/mainwindow.cpp:707
msgid "Suspend-to-RAM (S3)"
msgstr "Bereitschaft bis RAM (S3)"

#: src/mainwindow.cpp:565 src/mainwindow.cpp:709
msgid "Shallow (S1)"
msgstr "Oberflächlich (S1)"

#: src/mainwindow.cpp:574 src/mainwindow.cpp:608
msgid "Default — %1"
msgstr "Standard — %1"

#: src/mainwindow.cpp:597
msgid "Platform (the firmware powers off)"
msgstr "Plattform (die Firmware schaltet aus)"

#: src/mainwindow.cpp:599
msgid "Shutdown (the kernel powers off)"
msgstr "Herunterfahren (der Kernel schaltet aus)"

#: src/mainwindow.cpp:701
msgid "The kernel supports suspend."
msgstr "Der Kernel unterstützt den Bereitschaftsmodus."

#: src/mainwindow.cpp:711
msgid "The kernel supports suspend. Method in use: %1."
msgstr ""
"Der Kernel unterstützt den Bereitschaftsmodus. Verwendete Methode: %1."

#: src/mainwindow.cpp:714
msgid "The kernel does not support suspend."
msgstr "Der Kernel unterstützt den Bereitschaftsmodus nicht."

#: src/mainwindow.cpp:723 src/mainwindow.cpp:725
msgid "Kernel support"
msgstr "Kernel-Unterstützung"

#: src/mainwindow.cpp:723
msgid "The kernel supports hibernation."
msgstr "Der Kernel unterstützt den Ruhezustand."

#: src/mainwindow.cpp:725
msgid "The kernel does not support hibernation."
msgstr "Der Kernel unterstützt den Ruhezustand nicht."

#: src/mainwindow.cpp:755 src/mainwindow.cpp:757 src/mainwindow.cpp:759
msgid "Secure Boot"
msgstr "Secure Boot"

#: src/mainwindow.cpp:755
msgid "Secure Boot is enabled and the kernel lockdown prevents hibernation."
msgstr ""
"Secure Boot ist aktiviert und der Kernel-Lockdown verhindert den "
"Ruhezustand."

#: src/mainwindow.cpp:757
msgid "Secure Boot is enabled but the kernel lockdown is not active."
msgstr "Secure Boot ist aktiviert, aber der Kernel-Lockdown ist nicht aktiv."

#: src/mainwindow.cpp:759
msgid "Secure Boot is disabled."
msgstr "Secure Boot ist deaktiviert."

#: src/mainwindow.cpp:837
msgid "Swap"
msgstr "Swap"

#: src/mainwindow.cpp:837
msgid "No swap partition or swap file is in use."
msgstr "Es wird keine Swap-Partition oder Swap-Datei verwendet."

#: src/mainwindow.cpp:841
msgid "Swap area in %1"
msgstr "Swap-Bereich in %1"

#: src/mainwindow.cpp:845
msgid "The swap area (%1) is smaller than the memory (%2)."
msgstr "Der Swap-Bereich (%1) ist kleiner als der Arbeitsspeicher (%2)."

#: src/mainwindow.cpp:848
msgid "The swap area (%1) is at least as large as the memory (%2)."
msgstr ""
"Der Swap-Bereich (%1) ist mindestens so groß wie der Arbeitsspeicher (%2)."

#: src/mainwindow.cpp:878 src/mainwindow.cpp:883
msgid "Swap priority"
msgstr "Swap-Priorität"

#: src/mainwindow.cpp:879
msgid ""
"A zram device (priority %1) outranks the swap file (priority %2); "
"hibernation may fail with \"device or resource busy\"."
msgstr ""
"Ein zram-Gerät (Priorität %1) hat Vorrang vor der Swap-Datei (Priorität %2);"
" Ruhezustand kann mit „Gerät oder Ressource belegt“ fehlschlagen."

#: src/mainwindow.cpp:884
msgid "The swap file has the highest swap priority (%1)."
msgstr "Die Swap-Datei hat die höchste Swap-Priorität (%1)."

#: src/mainwindow.cpp:914 src/mainwindow.cpp:919
msgid "Hibernation compression"
msgstr "Ruhezustand-Kompression"

#: src/mainwindow.cpp:915
msgid ""
"The hibernation compressor %1 is not available in the kernel; hibernation "
"fails with \"Operation not supported\"."
msgstr ""
"Der Ruhezustand-Kompressor %1 ist im Kernel nicht verfügbar; der Ruhezustand"
" schlägt mit „Vorgang nicht unterstützt\" fehl."

#: src/mainwindow.cpp:920
msgid "The hibernation compressor %1 is available."
msgstr "Der Ruhezustand-Kompressor %1 ist verfügbar."

#: src/mainwindow.cpp:937 src/mainwindow.cpp:942
msgid "Hyper-V devices"
msgstr "Hyper-V-Geräte"

#: src/mainwindow.cpp:938
msgid ""
"The uio_hv_generic driver is bound to %1 VMBus device(s) and has no suspend "
"support, which aborts hibernation."
msgstr ""
"Der Treiber uio_hv_generic ist an %1 VMBus-Gerät(e) gebunden und unterstützt"
" kein Suspend, wodurch der Ruhezustand abgebrochen wird."

#: src/mainwindow.cpp:943
msgid "No VMBus device is bound to uio_hv_generic."
msgstr "Kein VMBus-Gerät ist an uio_hv_generic gebunden."

#: src/mainwindow.cpp:962 src/mainwindow.cpp:966
msgid "VMware graphics"
msgstr "VMware-Grafik"

#: src/mainwindow.cpp:963
msgid ""
"The vmwgfx driver refuses to freeze while a graphical session holds a DRM "
"context, which aborts hibernation."
msgstr ""
"Der Treiber vmwgfx verweigert das Einfrieren, solange eine grafische Sitzung"
" einen DRM-Kontext hält, wodurch der Ruhezustand abgebrochen wird."

#: src/mainwindow.cpp:967
msgid "The vmwgfx driver will be released during hibernation."
msgstr "Der Treiber vmwgfx wird während des Ruhezustands freigegeben."

#: src/mainwindow.cpp:987
msgid "Hibernation drivers"
msgstr "Ruhezustand-Treiber"

#: src/mainwindow.cpp:988
msgid ""
"%1 driver(s) abort the freezer and are detached while the image is written: "
"%2"
msgstr ""
"%1 Treiber brechen das Einfrieren ab und werden beim Schreiben des Abbilds "
"getrennt: %2"

#: src/mainwindow.cpp:996
msgid "Last hibernation"
msgstr "Letzter Ruhezustand"

#: src/mainwindow.cpp:997
msgid ""
"The previous hibernation attempt failed; the failing driver can be released "
"automatically."
msgstr ""
"Der letzte Ruhezustand-Versuch ist fehlgeschlagen; der verursachende Treiber"
" kann automatisch freigegeben werden."

#: src/mainwindow.cpp:1015 src/mainwindow.cpp:1033 src/mainwindow.cpp:1038
msgid "Resume device"
msgstr "Aufwachgerät"

#: src/mainwindow.cpp:1015
msgid "No resume device is set."
msgstr "Es ist kein Aufwachgerät eingestellt."

#: src/mainwindow.cpp:1034
msgid ""
"The resume device (%1:%2) does not match any swap partition or swap file in "
"use."
msgstr ""
"Das Aufwachgerät (%1:%2) stimmt mit keiner verwendeten Swap-Partition oder "
"Swap-Datei überein."

#: src/mainwindow.cpp:1039
msgid "The resume device is set to %1."
msgstr "Das Aufwachgerät ist auf %1 eingestellt."

#: src/mainwindow.cpp:1062 src/mainwindow.cpp:1067 src/mainwindow.cpp:1085
#: src/mainwindow.cpp:1090 src/mainwindow.cpp:1104 src/mainwindow.cpp:1108
msgid "SELinux"
msgstr "SELinux"

#: src/mainwindow.cpp:1063
msgid ""
"The swap file %1 is not labeled with swapfile_t; hibernation may be denied "
"under SELinux enforcing mode."
msgstr ""
"Die Swap-Datei %1 ist nicht mit swapfile_t bezeichnet; Ruhezustand kann im "
"SELinux-Erzwingungsmodus verweigert werden."

#: src/mainwindow.cpp:1068
msgid "The swap file %1 is correctly labeled with swapfile_t."
msgstr "Die Swap-Datei %1 ist korrekt mit swapfile_t bezeichnet."

#: src/mainwindow.cpp:1086
msgid ""
"The swap directory %1 has an SELinux context that systemd-logind cannot "
"search."
msgstr ""
"Das Swap-Verzeichnis %1 hat einen SELinux-Kontext, den systemd-logind nicht "
"durchsuchen kann."

#: src/mainwindow.cpp:1091
msgid "The swap directory %1 has a searchable SELinux context."
msgstr "Das Swap-Verzeichnis %1 hat einen durchsuchbaren SELinux-Kontext."

#: src/mainwindow.cpp:1105
msgid ""
"The SELinux boolean domain_kernel_dump is off; hibernation to swap is not "
"permitted."
msgstr ""
"Die SELinux-Boolesche Variable domain_kernel_dump ist aus; Ruhezustand auf "
"Swap ist nicht erlaubt."

#: src/mainwindow.cpp:1109
msgid "The SELinux boolean domain_kernel_dump is on."
msgstr "Die SELinux-Boolesche Variable domain_kernel_dump ist an."

#: src/mainwindow.cpp:1122
msgid "No problems detected"
msgstr "Keine Probleme erkannt"

#: src/mainwindow.cpp:1122
msgid "This computer looks ready for the sleep modes above."
msgstr ""
"Dieser Computer scheint für die oben genannten Energieverwaltungszustände "
"bereit zu sein."

#: src/mainwindow.cpp:1187
msgid "None"
msgstr "Keine"

#: src/mainwindow.cpp:1225 src/mainwindow.cpp:2139
msgid "Unable to create a temporary file."
msgstr "Eine temporäre Datei kann nicht erstellt werden."

#: src/mainwindow.cpp:1225 src/mainwindow.cpp:1252 src/mainwindow.cpp:1263
#: src/mainwindow.cpp:2139 src/mainwindow.cpp:2167 src/mainwindow.cpp:2178
msgid "Apply failed"
msgstr "Anwenden fehlgeschlagen"

#: src/mainwindow.cpp:1245
msgid "Sleep settings saved. Reboot for the changes to take full effect."
msgstr ""
"Energieverwaltungseinstellungen gespeichert. Starten Sie neu, damit die "
"Änderungen vollständig wirksam werden."

#: src/mainwindow.cpp:1247
msgid ""
"Sleep settings have been saved. Reboot for the changes to take full effect."
msgstr ""
"Energieverwaltungseinstellungen wurden gespeichert. Starten Sie neu, damit "
"die Änderungen vollständig wirksam werden."

#: src/mainwindow.cpp:1248 src/mainwindow.cpp:2163
msgid "Apply completed"
msgstr "Anwenden abgeschlossen"

#: src/mainwindow.cpp:1251
msgid ""
"Saving sleep settings failed.\n"
"\n"
"%1"
msgstr ""
"Speichern der Energieverwaltungseinstellungen fehlgeschlagen.\n"
"\n"
"%1"

#: src/mainwindow.cpp:1262 src/mainwindow.cpp:1317 src/mainwindow.cpp:1556
#: src/mainwindow.cpp:1560 src/mainwindow.cpp:1980 src/mainwindow.cpp:2177
#: src/mainwindow.cpp:2227 src/mainwindow.cpp:2410 src/mainwindow.cpp:2413
#: src/mainwindow.cpp:2541 src/mainwindow.cpp:2544 src/mainwindow.cpp:2748
#: src/mainwindow.cpp:2751 src/mainwindow.cpp:2872 src/mainwindow.cpp:2875
#: src/mainwindow.cpp:3011 src/mainwindow.cpp:3134 src/mainwindow.cpp:3137
#: src/mainwindow.cpp:3213
msgid ""
"Unable to start pkexec. Make sure polkit is installed and run this program "
"from a graphical session."
msgstr ""
"pkexec kann nicht gestartet werden. Stellen Sie sicher, dass polkit "
"installiert ist, und starten Sie dieses Programm aus einer grafischen "
"Sitzung."

#: src/mainwindow.cpp:1280
msgid "Fixing…"
msgstr "Wird behoben…"

#: src/mainwindow.cpp:1299
msgid ""
"The detected problems have been fixed. Reboot for the changes to take full "
"effect."
msgstr ""
"Die erkannten Probleme wurden behoben. Starten Sie neu, damit die Änderungen"
" vollständig wirksam werden."

#: src/mainwindow.cpp:1300
msgid "Fix completed"
msgstr "Behebung abgeschlossen"

#: src/mainwindow.cpp:1304
msgid ""
"Failed to fix the detected problems.\n"
"\n"
