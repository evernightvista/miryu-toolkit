#: src/grubconfighelper.cpp:70
msgid "The input file was not generated by Miryu GRUB2 Boot Config."
msgstr "입력 파일은 Miryu GRUB2 Boot Config에서 생성된 것이 아닙니다."

#: src/grubconfighelper.cpp:102
msgid "GRUB_TIMEOUT must be between -1 and 3600."
msgstr "GRUB_TIMEOUT은 -1에서 3600 사이여야 합니다."

#: src/grubconfighelper.cpp:131
msgid "Unsupported or unsafe configuration line: %1"
msgstr "지원되지 않거나 안전하지 않은 설정 행: %1"

#: src/grubconfighelper.cpp:136
msgid "The configuration is incomplete."
msgstr "설정이 불완전합니다."

#: src/grubconfighelper.cpp:212
msgid "Could not open %1 for writing."
msgstr "%1을(를) 쓰기용으로 열 수 없습니다."

#: src/grubconfighelper.cpp:218
msgid "Could not atomically replace %1."
msgstr "%1을(를) 원자적으로 교체할 수 없습니다."

#: src/grubconfighelper.cpp:236
msgid "Warning: could not remove the old drop-in file %1."
msgstr "경고: 이전 drop-in 파일 %1을(를) 제거할 수 없습니다."

#: src/grubconfighelper.cpp:282
msgid "Could not apply new kernel parameters to BLS entries."
msgstr "새 커널 매개변수를 BLS 항목에 적용할 수 없습니다."

#: src/grubconfighelper.cpp:293
msgid "Could not remove old kernel parameters from BLS entries."
msgstr "이전 커널 매개변수를 BLS 항목에서 제거할 수 없습니다."

#: src/grubconfighelper.cpp:329
msgid "grub2-mkconfig timed out."
msgstr "grub2-mkconfig 시간 초과."

#: src/grubconfighelper.cpp:339
msgid "grub2-mkconfig failed."
msgstr "grub2-mkconfig 실패."

# Helper messages
#: src/grubconfighelper.cpp:357
msgid ""
"Usage: miryu-toolkit-grub-config-helper --apply <generated-config-file>"
msgstr "사용법: miryu-toolkit-grub-config-helper --apply <생성된-설정-파일>"

#: src/grubconfighelper.cpp:362
msgid "This helper must run as root through polkit."
msgstr "이 도우미는 polkit을 통해 root로 실행해야 합니다."

#: src/grubconfighelper.cpp:368
msgid "Reading configuration file..."
msgstr "구성 파일을 읽는 중..."

#: src/grubconfighelper.cpp:373
msgid "Could not read the generated configuration file."
msgstr "생성된 설정 파일을 읽을 수 없습니다."

#: src/grubconfighelper.cpp:377
msgid "Parsing configuration..."
msgstr "구성을 분석하는 중..."

#: src/grubconfighelper.cpp:386
msgid "Reading existing %1..."
msgstr "기존 %1을(를) 읽는 중..."

#: src/grubconfighelper.cpp:400
msgid "Writing %1..."
msgstr "%1에 쓰는 중..."

#: src/grubconfighelper.cpp:413
msgid "Updating BLS entries..."
msgstr "BLS 항목을 업데이트하는 중..."

#: src/grubconfighelper.cpp:422
msgid "Regenerating GRUB configuration..."
msgstr "GRUB 구성을 다시 생성하는 중..."

#: src/grubconfighelper.cpp:430
msgid "GRUB2 configuration updated."
msgstr "GRUB2 구성이 업데이트되었습니다."

#: src/main.cpp:14 src/mainwindow.cpp:68 src/mainwindow.cpp:106
#: src/mainwindow.cpp:1351 kcm/kcm_miryu_toolkit.cpp:41
msgid "Miryu Toolkit"
msgstr "Miryu 도구 상자"

#: src/main.cpp:16
msgid "Miryu system utility toolkit"
msgstr "Miryu 시스템 유틸리티 도구 상자"

#: src/main.cpp:18
msgid "(c) 2026 Miryu"
msgstr "(c) 2026 Miryu"

#: src/mainwindow.cpp:75
msgid ""
"Manage Miryu components, maintenance tasks, system-wide environment "
"variables and sleep settings in one place."
msgstr "Miryu 구성 요소, 유지 관리 작업, 시스템 전체 환경 변수 및 절전 설정을 한 곳에서 관리합니다."

#: src/mainwindow.cpp:89 src/mainwindow.cpp:185
msgid "Miryu System Assistant"
msgstr "Miryu 시스템 어시스턴트"

#: src/mainwindow.cpp:90 src/mainwindow.cpp:1589
msgid "Boot Menu"
msgstr "부팅 메뉴"

#: src/mainwindow.cpp:91
msgid "System-wide environment variables"
msgstr "시스템 전체 환경 변수"

#: src/mainwindow.cpp:92
msgid "Sleep"
msgstr "절전"

#: src/mainwindow.cpp:93
msgid "Install additional components"
msgstr "추가 구성 요소 설치"

#: src/mainwindow.cpp:94
msgid "About"
msgstr "정보"

#: src/mainwindow.cpp:98
msgid "Ready"
msgstr "준비됨"

#: src/mainwindow.cpp:119
msgid "Install Fedora official kernel"
msgstr "Fedora 공식 커널 설치"

#: src/mainwindow.cpp:120
msgid ""
"If some games' anti-cheat systems use Epic EAC Linux v2 and cannot start, "
"you can install the Fedora official kernel to solve the problem."
msgstr ""
"일부 게임의 안티치트 시스템이 Epic EAC Linux v2를 사용하여 시작할 수 없는 경우 Fedora 공식 커널을 설치하여 문제를 "
"해결할 수 있습니다."

#: src/mainwindow.cpp:133
msgid "Install Wine"
msgstr "Wine 설치"

#: src/mainwindow.cpp:134
msgid ""
"Install Wine, DXVK, Winetricks and WineASIO for running Windows programs and"
" some audio workflows."
msgstr ""
"Windows 프로그램과 일부 오디오 작업 흐름을 실행하기 위해 Wine, DXVK, Winetricks 및 WineASIO를 "
"설치합니다."

#: src/mainwindow.cpp:147
msgid "Install Steam"
msgstr "Steam 설치"

#: src/mainwindow.cpp:148
msgid ""
"Install the Steam client. Steam will download update files on first launch."
msgstr "Steam 클라이언트를 설치합니다. 처음 실행할 때 Steam이 업데이트 파일을 다운로드합니다."

#: src/mainwindow.cpp:155
msgid "Install MIDI playback support"
msgstr "MIDI 재생 지원 설치"

#: src/mainwindow.cpp:156
msgid ""
"Install the FluidSynth GStreamer plugin to enable MIDI file playback "
"support."
msgstr "MIDI 파일 재생 지원을 사용하려면 FluidSynth GStreamer 플러그인을 설치합니다."

#: src/mainwindow.cpp:163
msgid "Install additional fonts"
msgstr "추가 글꼴 설치"

#: src/mainwindow.cpp:164
msgid ""
"Install Noto Sans, Noto Serif, monospace and CJK supplemental fonts to "
"improve multilingual display."
msgstr "다국어 표시를 개선하기 위해 Noto Sans, Noto Serif, 고정폭 및 CJK 보조 글꼴을 설치합니다."

#: src/mainwindow.cpp:189 src/mainwindow.cpp:2298
msgid "Clean up previous kernel"
msgstr "이전 커널 정리"

#: src/mainwindow.cpp:194 src/mainwindow.cpp:2678
msgid "Update system"
msgstr "시스템 업데이트"

#: src/mainwindow.cpp:199
msgid "List failed systemd service units"
msgstr "실패한 systemd 서비스 유닛 나열"

#: src/mainwindow.cpp:204 src/mainwindow.cpp:2965
msgid "Unlock RPM database"
msgstr "RPM 데이터베이스 잠금 해제"

#: src/mainwindow.cpp:209
msgid "View dnf5 log"
msgstr "dnf5 로그 보기"

#: src/mainwindow.cpp:214
msgid "Clean unused packages (dnf5 autoremove)"
msgstr "불필요한 패키지 정리 (dnf5 autoremove)"

#: src/mainwindow.cpp:219
msgid "View software crash information"
msgstr "소프트웨어 충돌 정보 보기"

#: src/mainwindow.cpp:224
msgid "Collect system logs"
msgstr "시스템 로그 수집"

#: src/mainwindow.cpp:242
msgid "Additional components"
msgstr "추가 구성 요소"

#: src/mainwindow.cpp:250
msgid "Refresh status"
msgstr "상태 새로 고침"

#: src/mainwindow.cpp:275
msgid "Status: checking"
msgstr "상태: 확인 중"

#: src/mainwindow.cpp:285
msgid "Packages: %1"
msgstr "패키지: %1"

#: src/mainwindow.cpp:292 src/mainwindow.cpp:1453
msgid "Install"
msgstr "설치"

#: src/mainwindow.cpp:293 src/mainwindow.cpp:1453
msgid "Uninstall"
msgstr "제거"

#: src/mainwindow.cpp:318
msgid "Environment variables"
msgstr "환경 변수"

#: src/mainwindow.cpp:321
msgid ""
"Set system-wide environment variables using the NAME=VALUE format. Changes "
"are written to /etc/environment and take effect after logging in again."
msgstr ""
"NAME=VALUE 형식으로 시스템 전체 환경 변수를 설정합니다. 변경 사항은 /etc/environment에 기록되며 다시 로그인한 후"
" 적용됩니다."

#: src/mainwindow.cpp:331 src/mainwindow.cpp:1650
msgid "Edit"
msgstr "편집"

#: src/mainwindow.cpp:333
msgid "Reload"
msgstr "다시 불러오기"

#: src/mainwindow.cpp:334 src/mainwindow.cpp:2195 src/mainwindow.cpp:2196
msgid "Restore defaults"
msgstr "기본값 복원"

#: src/mainwindow.cpp:335
msgid "Apply"
msgstr "적용"

#: src/mainwindow.cpp:345
msgid "Log out and log back in for changes to take effect."
msgstr "변경 사항을 적용하려면 로그아웃한 뒤 다시 로그인하세요."

#: src/mainwindow.cpp:381
msgid "Allowed sleep modes"
msgstr "허용된 절전 모드"

#: src/mainwindow.cpp:385
msgid "Choose the sleep modes you want to allow."
msgstr "허용할 절전 모드를 선택하세요."

#: src/mainwindow.cpp:410 src/mainwindow.cpp:701 src/mainwindow.cpp:711
#: src/mainwindow.cpp:714 src/mainwindow.cpp:1180
msgid "Suspend"
msgstr "절전(대기)"

#: src/mainwindow.cpp:411
msgid ""
"Keeps the session in memory (RAM). The computer is still running but uses "
"only a bit of power."
msgstr "세션을 메모리(RAM)에 유지합니다. 컴퓨터는 계속 실행되지만 전력 소모가 적습니다."

#: src/mainwindow.cpp:414 src/mainwindow.cpp:1183
msgid "Hibernate"
msgstr "최대 절전"

#: src/mainwindow.cpp:415
msgid "Saves the session to disk (Swap). Shuts down the computer."
msgstr "세션을 디스크(스왑)에 저장합니다. 컴퓨터의 전원을 끕니다."

#: src/mainwindow.cpp:418
msgid "Suspend then hibernate"
msgstr "절전 후 최대 절전"

#: src/mainwindow.cpp:419
msgid ""
"Suspends for a while (systemd decides how long, based on battery power), "
"then hibernates."
msgstr "잠시 절전한 후(systemd가 배터리 잔량에 따라 시간을 결정함) 최대 절전합니다."

#: src/mainwindow.cpp:422
msgid "Hybrid sleep"
msgstr "하이브리드 절전"

#: src/mainwindow.cpp:423
msgid "Suspends but also saves the session to disk (Swap)."
msgstr "절전하는 동시에 세션을 디스크(스왑)에도 저장합니다."

#: src/mainwindow.cpp:429
msgid "Suspend method"
msgstr "절전 방식"

#: src/mainwindow.cpp:432
msgid ""
"This is the method used to suspend the computer. Only the methods offered by"
" your BIOS/firmware can be chosen."
msgstr "컴퓨터를 절전하는 데 사용되는 방식입니다. BIOS/펌웨어가 제공하는 방식만 선택할 수 있습니다."

#: src/mainwindow.cpp:446
msgid "Hibernation method"
msgstr "최대 절전 방식"

#: src/mainwindow.cpp:449
msgid "This is the method used to power off the computer during hibernation."
msgstr "최대 절전 중에 컴퓨터 전원을 끄는 데 사용되는 방식입니다."

#: src/mainwindow.cpp:463
msgid "Detected problems"
msgstr "감지된 문제"

#: src/mainwindow.cpp:465
msgid "Fix the detected problems to make your allowed sleep modes available."
msgstr "허용한 절전 모드를 사용하려면 감지된 문제를 수정하세요."

#: src/mainwindow.cpp:475 src/mainwindow.cpp:1293 src/mainwindow.cpp:1314
msgid "Fix detected problems"
msgstr "감지된 문제 해결"

#: src/mainwindow.cpp:484
msgid "Available sleep modes"
msgstr "사용 가능한 절전 모드"

#: src/mainwindow.cpp:486
msgid "These are the sleep modes systemd reports as available right now."
msgstr "systemd가 현재 사용 가능하다고 보고하는 절전 모드입니다."

#: src/mainwindow.cpp:499 src/mainwindow.cpp:1689
msgid "Saving requires administrator authentication through polkit."
msgstr "저장하려면 polkit을 통한 관리자 인증이 필요합니다."

#: src/mainwindow.cpp:501
msgid "Apply sleep settings"
msgstr "절전 설정 적용"

#: src/mainwindow.cpp:550 src/mainwindow.cpp:586
msgid "Default"
msgstr "기본값"

#: src/mainwindow.cpp:561 src/mainwindow.cpp:705
msgid "Suspend-to-idle (s2idle)"
msgstr "아이들 절전(s2idle)"

#: src/mainwindow.cpp:563 src/mainwindow.cpp:707
msgid "Suspend-to-RAM (S3)"
msgstr "램 절전(S3)"

#: src/mainwindow.cpp:565 src/mainwindow.cpp:709
msgid "Shallow (S1)"
msgstr "얕은 절전(S1)"

#: src/mainwindow.cpp:574 src/mainwindow.cpp:608
msgid "Default — %1"
msgstr "기본값 — %1"

#: src/mainwindow.cpp:597
msgid "Platform (the firmware powers off)"
msgstr "플랫폼(펌웨어가 전원 끔)"

#: src/mainwindow.cpp:599
msgid "Shutdown (the kernel powers off)"
msgstr "시스템 종료(커널이 전원 끔)"

#: src/mainwindow.cpp:701
msgid "The kernel supports suspend."
msgstr "커널이 절전을 지원합니다."

#: src/mainwindow.cpp:711
msgid "The kernel supports suspend. Method in use: %1."
msgstr "커널이 절전을 지원합니다. 사용 중인 방식: %1."

#: src/mainwindow.cpp:714
msgid "The kernel does not support suspend."
msgstr "커널이 절전을 지원하지 않습니다."

#: src/mainwindow.cpp:723 src/mainwindow.cpp:725
msgid "Kernel support"
msgstr "커널 지원"

#: src/mainwindow.cpp:723
msgid "The kernel supports hibernation."
msgstr "커널이 최대 절전을 지원합니다."

#: src/mainwindow.cpp:725
msgid "The kernel does not support hibernation."
msgstr "커널이 최대 절전을 지원하지 않습니다."

#: src/mainwindow.cpp:755 src/mainwindow.cpp:757 src/mainwindow.cpp:759
msgid "Secure Boot"
msgstr "보안 부팅"

#: src/mainwindow.cpp:755
msgid "Secure Boot is enabled and the kernel lockdown prevents hibernation."
msgstr "보안 부팅이 활성화되어 있고 커널 잠금이 최대 절전을 방지합니다."

#: src/mainwindow.cpp:757
msgid "Secure Boot is enabled but the kernel lockdown is not active."
msgstr "보안 부팅은 활성화되어 있지만 커널 잠금은 활성화되지 않았습니다."

#: src/mainwindow.cpp:759
msgid "Secure Boot is disabled."
msgstr "보안 부팅이 비활성화되어 있습니다."

#: src/mainwindow.cpp:837
msgid "Swap"
msgstr "스왑"

#: src/mainwindow.cpp:837
msgid "No swap partition or swap file is in use."
msgstr "사용 중인 스왑 파티션 또는 스왑 파일이 없습니다."

#: src/mainwindow.cpp:841
msgid "Swap area in %1"
msgstr "%1의 스왑 영역"

#: src/mainwindow.cpp:845
msgid "The swap area (%1) is smaller than the memory (%2)."
msgstr "스왑 영역(%1)이 메모리(%2)보다 작습니다."

#: src/mainwindow.cpp:848
msgid "The swap area (%1) is at least as large as the memory (%2)."
msgstr "스왑 영역(%1)이 메모리(%2) 이상입니다."

#: src/mainwindow.cpp:878 src/mainwindow.cpp:883
msgid "Swap priority"
msgstr "스왑 우선순위"

#: src/mainwindow.cpp:879
msgid ""
"A zram device (priority %1) outranks the swap file (priority %2); "
"hibernation may fail with \"device or resource busy\"."
msgstr ""
"zram 장치(우선순위 %1)가 스왑 파일(우선순위 %2)보다 높습니다. 최대 절전 모드가 \"장치 또는 리소스 사용 중\"으로 실패할 "
"수 있습니다."

#: src/mainwindow.cpp:884
msgid "The swap file has the highest swap priority (%1)."
msgstr "스왑 파일이 가장 높은 스왑 우선순위(%1)를 갖습니다."

#: src/mainwindow.cpp:914 src/mainwindow.cpp:919
msgid "Hibernation compression"
msgstr "최대 절전 모드 압축"

#: src/mainwindow.cpp:915
msgid ""
"The hibernation compressor %1 is not available in the kernel; hibernation "
"fails with \"Operation not supported\"."
msgstr "커널에 최대 절전 모드 압축 알고리즘 %1이(가) 없습니다. \"지원되지 않는 작업\"으로 인해 최대 절전 모드가 실패합니다."

#: src/mainwindow.cpp:920
msgid "The hibernation compressor %1 is available."
msgstr "최대 절전 모드 압축 알고리즘 %1을(를) 사용할 수 있습니다."

#: src/mainwindow.cpp:937 src/mainwindow.cpp:942
msgid "Hyper-V devices"
msgstr "Hyper-V 장치"

#: src/mainwindow.cpp:938
msgid ""
"The uio_hv_generic driver is bound to %1 VMBus device(s) and has no suspend "
"support, which aborts hibernation."
msgstr ""
"uio_hv_generic 드라이버가 %1개의 VMBus 장치에 바인딩되어 있으며 일시 중단을 지원하지 않아 최대 절전 모드가 "
"중단됩니다."

#: src/mainwindow.cpp:943
msgid "No VMBus device is bound to uio_hv_generic."
msgstr "uio_hv_generic에 바인딩된 VMBus 장치가 없습니다."

#: src/mainwindow.cpp:962 src/mainwindow.cpp:966
msgid "VMware graphics"
msgstr "VMware 그래픽"

#: src/mainwindow.cpp:963
msgid ""
"The vmwgfx driver refuses to freeze while a graphical session holds a DRM "
"context, which aborts hibernation."
msgstr "그래픽 세션이 DRM 컨텍스트를 보유하는 동안 vmwgfx 드라이버가 동결을 거부하여 최대 절전 모드가 중단됩니다."

#: src/mainwindow.cpp:967
msgid "The vmwgfx driver will be released during hibernation."
msgstr "최대 절전 모드 중에 vmwgfx 드라이버가 해제됩니다."

#: src/mainwindow.cpp:987
msgid "Hibernation drivers"
msgstr "최대 절전 드라이버"

#: src/mainwindow.cpp:988
msgid ""
"%1 driver(s) abort the freezer and are detached while the image is written: "
"%2"
msgstr "%1개의 드라이버가 동결을 중단시켜 이미지 기록 중 분리됩니다: %2"

#: src/mainwindow.cpp:996
msgid "Last hibernation"
msgstr "지난 최대 절전"

#: src/mainwindow.cpp:997
msgid ""
"The previous hibernation attempt failed; the failing driver can be released "
"automatically."
msgstr "지난 최대 절전 모드가 실패했습니다. 원인이 된 드라이버는 자동으로 해제할 수 있습니다."

#: src/mainwindow.cpp:1015 src/mainwindow.cpp:1033 src/mainwindow.cpp:1038
msgid "Resume device"
msgstr "절전 해제 장치"

#: src/mainwindow.cpp:1015
msgid "No resume device is set."
msgstr "절전 해제 장치가 설정되지 않았습니다."

#: src/mainwindow.cpp:1034
msgid ""
"The resume device (%1:%2) does not match any swap partition or swap file in "
"use."
msgstr "절전 해제 장치(%1:%2)가 사용 중인 스왑 파티션 또는 스왑 파일과 일치하지 않습니다."

#: src/mainwindow.cpp:1039
msgid "The resume device is set to %1."
msgstr "절전 해제 장치가 %1로 설정되었습니다."

