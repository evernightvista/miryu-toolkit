#: src/bootbackup.cpp:88
msgid "The backup path contains a symbolic link or is not absolute."
msgstr ""
"Le chemin de sauvegarde contient un lien symbolique ou n'est pas absolu."

#: src/bootbackup.cpp:91
msgid "Cannot create a traversable backup directory."
msgstr ""
"Impossible de créer un répertoire de sauvegarde avec les permissions de "
"traversée nécessaires."

#: src/bootbackup.cpp:99
msgid "Unsafe backup output path."
msgstr "Chemin de sortie de sauvegarde non sécurisé."

#: src/bootbackup.cpp:102
msgid "Cannot open a private backup file for writing."
msgstr "Impossible d'ouvrir un fichier de sauvegarde privé en écriture."

#: src/bootbackup.cpp:104
msgid "Cannot atomically write a backup file."
msgstr "Impossible d'écrire un fichier de sauvegarde de manière atomique."

#: src/bootbackup.cpp:111
msgid "Unsafe backup metadata output path."
msgstr "Chemin de sortie des métadonnées de sauvegarde non sécurisé."

#: src/bootbackup.cpp:114
msgid "Cannot open backup metadata for writing."
msgstr "Impossible d'ouvrir les métadonnées de sauvegarde en écriture."

#: src/bootbackup.cpp:116
msgid "Cannot atomically write backup metadata."
msgstr "Impossible d'écrire les métadonnées de sauvegarde de manière atomique."

#: src/bootbackup.cpp:194
msgid "A restore destination contains a symbolic link: %1"
msgstr "Une destination de restauration contient un lien symbolique : %1"

#: src/bootbackup.cpp:197
msgid "A restore destination is not a regular file: %1"
msgstr "Une destination de restauration n'est pas un fichier ordinaire : %1"

#: src/bootbackup.cpp:200
msgid "A restore destination directory is unavailable: %1"
msgstr "Un répertoire de destination de restauration est indisponible : %1"

#: src/bootbackup.cpp:235
msgid "The backup target has no block-device identity."
msgstr ""
"La cible de sauvegarde ne possède aucune identité de périphérique bloc."

#: src/bootbackup.cpp:239
msgid "The automatic backup target identity is inconsistent."
msgstr "L'identité de la cible de sauvegarde automatique est incohérente."

#: src/bootbackup.cpp:244
msgid "The mounted backup target does not match its recorded root."
msgstr ""
"La cible de sauvegarde montée ne correspond pas à sa racine enregistrée."

#: src/bootbackup.cpp:252
msgid "The target root is now backed by a different block device."
msgstr "La racine cible repose désormais sur un autre périphérique bloc."

#: src/bootbackup.cpp:260
msgid "The selected backup ID or root is invalid."
msgstr "La sauvegarde sélectionnée possède un ID ou une racine non valide."

#: src/bootbackup.cpp:263
msgid "The selected backup root is unavailable."
msgstr "La racine de sauvegarde sélectionnée est indisponible."

#: src/bootbackup.cpp:266
msgid "The selected backup is unavailable."
msgstr "La sauvegarde sélectionnée est indisponible."

#: src/bootbackup.cpp:271
msgid "The selected backup manifest is unavailable."
msgstr "Le manifeste de la sauvegarde sélectionnée est indisponible."

#: src/bootbackup.cpp:275
msgid "The selected backup manifest is too large."
msgstr "Le manifeste de la sauvegarde sélectionnée est trop volumineux."

#: src/bootbackup.cpp:280
msgid "The selected backup manifest is damaged."
msgstr "Le manifeste de la sauvegarde sélectionnée est endommagé."

#: src/bootbackup.cpp:305
msgid "The backup manifest ID does not match its directory."
msgstr "L'ID du manifeste de sauvegarde ne correspond pas à son répertoire."

#: src/bootbackup.cpp:307
msgid "The backup changed after it was reviewed. Refresh and try again."
msgstr ""
"La sauvegarde a été modifiée après sa vérification. Actualisez, puis "
"réessayez."

#: src/bootbackup.cpp:310
msgid "The restore target root is unavailable or unsafe."
msgstr "La racine cible de restauration est indisponible ou non sécurisée."

#: src/bootbackup.cpp:318
msgid "The selected backup belongs to a different target identity."
msgstr ""
"La sauvegarde sélectionnée appartient à une cible dont l'identité est "
"différente."

#: src/bootbackup.cpp:323
msgid "This backup contains no restorable configuration files."
msgstr ""
"Cette sauvegarde ne contient aucun fichier de configuration restaurable."

#: src/bootbackup.cpp:328
msgid "The backup contains an invalid file record."
msgstr "La sauvegarde contient un enregistrement de fichier non valide."

#: src/bootbackup.cpp:333
msgid "The backup contains a disallowed or duplicate path."
msgstr "La sauvegarde contient un chemin non autorisé ou en double."

#: src/bootbackup.cpp:338
msgid "The backup contains invalid file permissions."
msgstr "La sauvegarde contient des permissions de fichier non valides."

#: src/bootbackup.cpp:343
msgid "A newly-created file record contains an unexpected original."
msgstr ""
"L'enregistrement d'un fichier nouvellement créé mentionne un fichier "
"d'origine inattendu."

#: src/bootbackup.cpp:346
msgid "A newly-created file has an invalid post-operation hash."
msgstr ""
"L'empreinte calculée après l'opération pour un fichier nouvellement créé "
"n'est pas valide."

#: src/bootbackup.cpp:354
msgid "The backup contains an invalid saved-file record."
msgstr ""
"La sauvegarde contient un enregistrement de fichier sauvegardé non valide."

#: src/bootbackup.cpp:359
msgid "A saved configuration file is damaged: %1"
msgstr "Un fichier de configuration sauvegardé est endommagé : %1"

#: src/bootbackup.cpp:362
msgid "The saved configuration exceeds the size limit."
msgstr "La configuration sauvegardée dépasse la taille maximale autorisée."

#: src/bootbackup.cpp:385
msgid "An offline backup requires an explicit mounted restore target."
msgstr ""
"Une sauvegarde hors ligne nécessite de spécifier explicitement une cible de "
"restauration montée."

#: src/bootbackup.cpp:486
msgid "The backup contains a disallowed restore path."
msgstr "La sauvegarde contient un chemin de restauration non autorisé."

#: src/bootbackup.cpp:525
msgid "The backup source root is unavailable or unsafe."
msgstr "La racine source de sauvegarde est indisponible ou non sécurisée."

#: src/bootbackup.cpp:527
msgid "Too many configuration files were selected for backup."
msgstr ""
"Trop de fichiers de configuration ont été sélectionnés pour la sauvegarde."

#: src/bootbackup.cpp:538
msgid "Cannot create a private transaction backup."
msgstr "Impossible de créer une sauvegarde de transaction privée."

#: src/bootbackup.cpp:547
msgid "A configuration path is outside the backup whitelist or duplicated: %1"
msgstr ""
"Un chemin de configuration est hors de la liste blanche de sauvegarde ou en "
"double : %1"

#: src/bootbackup.cpp:559
msgid "An unsafe or oversized configuration backup source: %1"
msgstr ""
"Une source de sauvegarde de configuration n'est pas sécurisée ou est trop "
"volumineuse : %1"

#: src/bootbackup.cpp:562
msgid "The configuration backup exceeds the total size limit."
msgstr ""
"La sauvegarde de configuration dépasse la taille totale maximale autorisée."

#: src/bootbackup.cpp:565
msgid "Cannot read configuration for backup: %1"
msgstr "Impossible de lire la configuration pour la sauvegarde : %1"

#: src/bootbackup.cpp:568
msgid "Configuration changed or could not be read: %1"
msgstr "La configuration a été modifiée ou n'a pas pu être lue : %1"

#: src/bootbackup.cpp:617
msgid "The transaction backup directory is unsafe."
msgstr "Le répertoire de sauvegarde de transaction n'est pas sécurisé."

#: src/bootbackup.cpp:620
msgid "The transaction manifest is too large."
msgstr "Le manifeste de transaction est trop volumineux."

#: src/bootbackup.cpp:627 src/bootbackup.cpp:698
msgid "The transaction backup is not initialized."
msgstr "La sauvegarde de transaction n'est pas initialisée."

#: src/bootbackup.cpp:642
msgid "A newly-created configuration path became unsafe."
msgstr "Un chemin de configuration nouvellement créé n'est plus sécurisé."

#: src/bootbackup.cpp:648
msgid "A newly-created configuration is not a regular file."
msgstr ""
"Une configuration nouvellement créée ne correspond pas à un fichier "
"ordinaire."

#: src/bootbackup.cpp:652
msgid "Cannot fingerprint a newly-created configuration file."
msgstr ""
"Impossible de calculer l'empreinte d'un fichier de configuration "
"nouvellement créé."

#: src/bootbackup.cpp:664
msgid "Invalid operation record."
msgstr "Enregistrement d'opération non valide."

#: src/bootbackup.cpp:681 src/bootbackup.cpp:685
msgid "Cannot append to the operation log."
msgstr "Impossible d'ajouter une entrée au journal des opérations."

#: src/bootbackup.cpp:730
msgid ""
"Refusing to remove a configuration not fingerprinted by the transaction: %1"
msgstr ""
"Refus de supprimer une configuration dont l'empreinte n'a pas été "
"enregistrée par la transaction : %1"

#: src/bootbackup.cpp:734
msgid "Cannot verify a configuration created by the transaction: %1"
msgstr "Impossible de vérifier une configuration créée par la transaction : %1"

#: src/bootbackup.cpp:736
msgid "Refusing to remove a configuration changed after the transaction: %1"
msgstr ""
"Refus de supprimer une configuration modifiée après la transaction : %1"

#: src/bootbackup.cpp:738
msgid "Cannot remove a file created by the transaction: %1"
msgstr "Impossible de supprimer un fichier créé par la transaction : %1"

#: src/bootbackup.cpp:746
msgid "Cannot reopen a saved configuration: %1"
msgstr "Impossible de rouvrir une configuration sauvegardée : %1"

#: src/bootbackup.cpp:750
msgid "A saved configuration changed before restoration: %1"
msgstr ""
"Une configuration sauvegardée a été modifiée avant la restauration : %1"

#: src/bootbackup.cpp:757
msgid "Cannot atomically restore configuration: %1"
msgstr "Impossible de restaurer la configuration de manière atomique : %1"

#: src/bootbackup.cpp:761
msgid "Cannot restore configuration permissions: %1"
msgstr "Impossible de restaurer les permissions de la configuration : %1"

#: src/bootdata.cpp:242
msgid "Container and %1 wrappers are not read-only probes."
msgstr ""
"Les conteneurs et les scripts d'encapsulation %1 ne sont pas des outils de "
"détection en lecture seule."

#: src/bootdata.cpp:274
msgid "The command is not an allowed read-only boot probe."
msgstr ""
"La commande n'est pas un outil autorisé de détection du démarrage en lecture "
"seule."

#: src/bootdata.cpp:311
msgid "Read-only command timed out."
msgstr "La commande en lecture seule a dépassé le délai imparti."

#: src/bootdata.cpp:677
msgid "The EFI file or firmware label is invalid."
msgstr "Le fichier EFI ou le libellé du micrologiciel n'est pas valide."

#: src/bootdata.cpp:693
msgid "The EFI binary must be a regular file below %1 on a mounted ESP."
msgstr ""
"Le binaire EFI doit être un fichier ordinaire situé sous %1 sur une "
"partition système EFI (ESP) montée."

#: src/bootdata.cpp:708
msgid "The selected filesystem is not a mounted EFI system partition."
msgstr ""
"Le système de fichiers sélectionné n'est pas une partition système EFI "
"montée."

#: src/bootdata.cpp:719
msgid "The physical disk and EFI partition could not be identified."
msgstr "Le disque physique et la partition EFI n'ont pas pu être identifiés."

#: src/bootdata.cpp:726
msgid "The EFI disk is unavailable."
msgstr "Le disque EFI est indisponible."

#: src/bootdata.cpp:752
msgid "The certificate must be a DER file between 64 bytes and 64 KiB."
msgstr ""
"Le certificat doit être un fichier DER d'une taille comprise entre 64 octets "
"et 64 Kio."

#: src/bootdata.cpp:754
msgid "The certificate is not an ASN.1 DER SEQUENCE."
msgstr "Le certificat n'est pas une SEQUENCE ASN.1 DER."

#: src/bootdata.cpp:763
msgid "The DER certificate has an invalid length."
msgstr "La longueur du certificat DER n'est pas valide."

#: src/bootdata.cpp:767
msgid "The DER certificate uses a non-minimal length encoding."
msgstr "Le certificat DER utilise un encodage de longueur non minimal."

#: src/bootdata.cpp:770
msgid "The DER certificate is truncated or has trailing data."
msgstr "Le certificat DER est tronqué ou contient des données supplémentaires."

#: src/bootdata.cpp:832
msgid "Root device is absent from the current disk inventory."
msgstr "Le périphérique racine est absent de l'inventaire actuel des disques."

#: src/bootdata.cpp:837
msgid "Automatic repair supports only btrfs, ext4, xfs and f2fs partitions."
msgstr ""
"La réparation automatique prend uniquement en charge les partitions btrfs, "
"ext4, xfs et f2fs."

#: src/bootdata.cpp:840
msgid "The Btrfs subvolume name is invalid."
msgstr "Le nom du sous-volume Btrfs n'est pas valide."

#: src/bootdata.cpp:843
msgid ""
"Offline target: GRUB files and firmware paths will be checked after a "
"controlled mount."
msgstr ""
"Cible hors ligne : les fichiers GRUB et les chemins du micrologiciel seront "
"vérifiés après un montage contrôlé."

#: src/bootdata.cpp:847
msgid "The target does not contain %1 and %2."
msgstr "La cible ne contient ni %1 ni %2."

#: src/bootdata.cpp:853
msgid "Missing GRUB tool: %1"
msgstr "Outil GRUB manquant : %1"

#: src/bootdata.cpp:854
msgid "GRUB tool found: %1"
msgstr "Outil GRUB trouvé : %1"

#: src/bootdata.cpp:857
msgid "GRUB defaults found: %1"
msgstr "Paramètres GRUB par défaut trouvés : %1"

#: src/bootdata.cpp:858
msgid "GRUB defaults missing: %1"
msgstr "Paramètres GRUB par défaut manquants : %1"

#: src/bootdata.cpp:860
msgid "Generated GRUB configuration found: %1"
msgstr "Configuration GRUB générée trouvée : %1"

#: src/bootdata.cpp:861
msgid "Generated GRUB configuration not found: %1"
msgstr "Configuration GRUB générée introuvable : %1"

#: src/bootdata.cpp:891
msgid "No mounted EFI system partition was found inside the target."
msgstr "Aucune partition système EFI montée n'a été trouvée dans la cible."

#: src/bootdata.cpp:893
msgid "No EFI programs were found below %1 on the target ESP."
msgstr "Aucun programme EFI n'a été trouvé sous %1 sur l'ESP cible."

#: src/bootdata.cpp:896
msgid ""
"No resolvable UEFI firmware entry points to an EFI program on the target ESP."
msgstr ""
"Aucune entrée du micrologiciel UEFI ne permet de localiser un programme EFI "
"sur l'ESP cible."

#: src/bootdata.cpp:898
msgid "A UEFI firmware entry resolves to an EFI program on the target ESP."
msgstr ""
"Une entrée du micrologiciel UEFI permet de localiser un programme EFI sur "
"l'ESP cible."

#: src/bootdata.cpp:902
msgid "Legacy BIOS GRUB modules found: %1"
msgstr "Modules GRUB pour BIOS hérité trouvés : %1"

#: src/bootdata.cpp:903
msgid "Legacy BIOS GRUB modules missing: %1"
msgstr "Modules GRUB pour BIOS hérité manquants : %1"

#: src/bootdata.cpp:916
msgid ""
"The disk that contains the target root partition could not be determined."
msgstr ""
"Impossible de déterminer le disque contenant la partition racine cible."

#: src/bootdata.cpp:918
msgid "GRUB will be written to the master boot record of %1."
msgstr "GRUB sera écrit dans l'enregistrement d'amorçage principal de %1."

#: src/bootdata.cpp:927
msgid "The GPT disk has no BIOS boot partition; %1 will fail."
msgstr ""
"Le disque GPT ne contient aucune partition de démarrage BIOS ; %1 échouera."

#: src/bootdata.cpp:944
msgid "Reading UEFI firmware state"
msgstr "Lecture de l'état du micrologiciel UEFI"

#: src/bootdata.cpp:957
msgid "Could not read UEFI boot variables with %1."
msgstr "Impossible de lire les variables de démarrage UEFI avec %1."

#: src/bootdata.cpp:963
msgid "This system was not booted in UEFI mode."
msgstr "Ce système n'a pas démarré en mode UEFI."

#: src/bootdata.cpp:974
msgid ""
"Device and command probing is performed only for the running root filesystem."
msgstr ""
"La détection des périphériques et des commandes est effectuée uniquement "
"pour le système de fichiers racine en cours d'exécution."

#: src/bootdata.cpp:978
msgid "Finding EFI system partitions and Linux targets"
msgstr "Recherche des partitions système EFI et des cibles Linux"

#: src/bootdata.cpp:984
msgid "No mounted EFI system partition was detected."
msgstr "Aucune partition système EFI montée n'a été détectée."

#: src/bootdata.cpp:987
msgid "Reading Secure Boot certificates"
msgstr "Lecture des certificats Secure Boot"

#: src/bootdata.cpp:995
msgid "%1: %2"
msgstr "%1 : %2"

#: src/bootdata.cpp:999
msgid "UEFI firmware does not support Secure Boot."
msgstr "Le micrologiciel UEFI ne prend pas en charge le démarrage sécurisé."

#: src/bootdata.cpp:1032
msgid "The EFI boot variable is not writable: %1"
msgstr "La variable de démarrage EFI n'est pas accessible en écriture : %1"

#: src/bootdata.cpp:1038
msgid "The EFI boot variable could not be written: %1"
msgstr "Impossible d'écrire la variable de démarrage EFI : %1"

#: src/bootdata.cpp:1044
msgid "The EFI boot variable could not be flushed: %1"
msgstr "Impossible de synchroniser la variable de démarrage EFI : %1"

#: src/bootdata.cpp:1052
msgid "The EFI boot variable could not be resized: %1"
msgstr "Impossible de redimensionner la variable de démarrage EFI : %1"

#: src/bootdata.cpp:1076
msgid "No EFI boot variable destination was provided."
msgstr "Aucune destination n'a été fournie pour la variable de démarrage EFI."

#: src/bootdata.cpp:1079
msgid "The EFI boot variable could not be read: %1"
msgstr "Impossible de lire la variable de démarrage EFI : %1"

#: src/bootdata.cpp:1082
msgid "The EFI boot variable is too short: %1"
msgstr "La variable de démarrage EFI est trop courte : %1"

#: src/bootdata.cpp:1101
msgid "The EFI boot variable has no description terminator: %1"
msgstr ""
"La variable de démarrage EFI ne contient aucun caractère de fin de "
"description : %1"

#: src/bootdata.cpp:1103
msgid "The EFI boot variable device path is truncated: %1"
msgstr ""
"Le chemin de périphérique de la variable de démarrage EFI est tronqué : %1"

#: src/bootdata.cpp:1121 src/bootdata.cpp:1148
msgid "The EFI boot variable requires an authenticated update."
msgstr "La variable de démarrage EFI nécessite une mise à jour authentifiée."

#: src/bootdata.cpp:1124
msgid "The EFI boot variable label is invalid."
msgstr "Le libellé de la variable de démarrage EFI n'est pas valide."

#: src/boothelper.cpp:72
msgid "Could not start %1."
msgstr "Impossible de démarrer %1."

#: src/boothelper.cpp:80
msgid "Could not provide standard input to a privileged operation."
msgstr "Impossible de fournir une entrée standard à une opération privilégiée."

#: src/boothelper.cpp:88
msgid "%1 timed out."
msgstr "%1 a dépassé le délai imparti."

#: src/boothelper.cpp:91
msgid "%1 did not complete successfully."
msgstr "%1 ne s'est pas terminé correctement."

#: src/boothelper.cpp:196
msgid "Invalid mount point below the target root."
msgstr "Point de montage non valide sous la racine cible."

#: src/boothelper.cpp:199
msgid "A mount point contains a symbolic link: %1"
msgstr "Un point de montage contient un lien symbolique : %1"

#: src/boothelper.cpp:201
msgid "Cannot create mount point: %1"
msgstr "Impossible de créer le point de montage : %1"

#: src/boothelper.cpp:204
msgid "Mount point is not a directory: %1"
msgstr "Le point de montage n'est pas un répertoire : %1"

#: src/boothelper.cpp:207
msgid "Mount point escapes the selected target root."
msgstr ""
"Le point de montage se trouve en dehors de la racine cible sélectionnée."

#: src/boothelper.cpp:219
msgid "The target fstab is too large to validate."
msgstr "Le fichier fstab de la cible est trop volumineux pour être validé."

#: src/boothelper.cpp:228
msgid "The target has a separate /boot filesystem; mount it before repair."
msgstr ""
"La cible possède un système de fichiers /boot distinct ; montez-le avant la "
"réparation."

#: src/boothelper.cpp:260
msgid "The target block device or subvolume is invalid."
msgstr "Le périphérique bloc ou le sous-volume cible n'est pas valide."

#: src/boothelper.cpp:269
msgid ""
"Automatic repair requires a supported Linux partition and Btrfs subvolume."
msgstr ""
"La réparation automatique nécessite une partition Linux et un sous-volume "
"Btrfs pris en charge."

#: src/boothelper.cpp:273
msgid ""
"The selected automatic target is already mounted; select its mounted root "
"instead."
msgstr ""
"La cible automatique sélectionnée est déjà montée ; sélectionnez plutôt sa "
"racine montée."

#: src/boothelper.cpp:280
msgid "The mounted target root is invalid."
msgstr "La racine cible montée n'est pas valide."

#: src/boothelper.cpp:293
msgid ""
"The mounted Linux target is not in the allowed inventory or its mount source "
"changed."
msgstr ""
"La cible Linux montée ne figure pas dans l'inventaire autorisé ou sa source "
"de montage a changé."

#: src/boothelper.cpp:320
msgid "The GRUB installation disk path is invalid."
msgstr "Le chemin du disque d'installation de GRUB n'est pas valide."

#: src/boothelper.cpp:323
msgid "The GRUB installation target must be a whole disk."
msgstr "La cible d'installation de GRUB doit être un disque entier."

#: src/boothelper.cpp:326
msgid "The target root device is absent from the disk inventory."
msgstr "Le périphérique racine cible est absent de l'inventaire des disques."

#: src/boothelper.cpp:328
msgid "The selected disk does not contain the target root partition."
msgstr "Le disque sélectionné ne contient pas la partition racine cible."

#: src/boothelper.cpp:338
msgid "Only GRUB2 boot repair is supported."
msgstr "Seule la réparation du démarrage GRUB2 est prise en charge."

#: src/boothelper.cpp:341
msgid "Only GRUB2 UEFI or legacy BIOS repair is supported."
msgstr ""
"Seule la réparation du démarrage GRUB2 en mode UEFI ou BIOS hérité est prise "
"en charge."

#: src/boothelper.cpp:354
msgid "The disk inventory changed before repair was applied."
msgstr ""
"L'inventaire des disques a changé avant l'application de la réparation."

#: src/boothelper.cpp:358
msgid ""
"Legacy BIOS repair does not register firmware entries or fallback loaders."
msgstr ""
"La réparation BIOS hérité n'enregistre ni les entrées du micrologiciel ni "
"les chargeurs de secours."

#: src/boothelper.cpp:360
msgid "Legacy BIOS repair does not use an EFI system partition."
msgstr "La réparation BIOS hérité n'utilise pas de partition système EFI."

#: src/boothelper.cpp:367 src/bootrepairpage.cpp:745
msgid "Legacy BIOS repair is available on x86 systems only."
msgstr "La réparation BIOS hérité n'est disponible que sur les systèmes x86."

#: src/boothelper.cpp:371 src/boothelper.cpp:428
msgid "mount and umount are required for automatic repair."
msgstr "mount et umount sont requis pour la réparation automatique."

#: src/boothelper.cpp:388
msgid ""
"The ESP must be a vfat EFI-GUID partition distinct from the root partition."
msgstr ""
"L'ESP doit être une partition vfat au GUID EFI distincte de la partition "
"racine."

#: src/boothelper.cpp:392
msgid "The bootloader ID must be 1 to 80 safe ASCII characters."
msgstr ""
"L'ID du chargeur de démarrage doit comporter de 1 à 80 caractères ASCII "
"autorisés."

#: src/boothelper.cpp:396
msgid "The requested GRUB EFI architecture does not match this host."
msgstr "L'architecture EFI de GRUB demandée ne correspond pas à cet hôte."

#: src/boothelper.cpp:399
msgid "UEFI firmware registration is unavailable."
msgstr "L'enregistrement dans le micrologiciel UEFI est indisponible."

#: src/boothelper.cpp:404
msgid ""
"A UEFI boot entry named %1 already exists. Remove it or use a different "
"bootloader ID."
msgstr ""
"Une entrée de démarrage UEFI nommée %1 existe déjà. Supprimez-la ou utilisez "
"un autre identifiant de chargeur d’amorçage."

#: src/boothelper.cpp:412
msgid "The ESP path is not canonical or contains a symbolic link."
msgstr "Le chemin de l'ESP n'est pas canonique ou contient un lien symbolique."

#: src/boothelper.cpp:423
msgid "The selected ESP mount is not active or its source changed."
msgstr ""
"Le montage de l'ESP sélectionnée n'est pas actif ou sa source a changé."

#: src/boothelper.cpp:434
msgid "The mounted ESP must be at the selected path inside the target root."
msgstr ""
"L'ESP montée doit se trouver au chemin sélectionné dans la racine cible."

#: src/boothelper.cpp:455
msgid "The mounted target is not a valid Linux root."
msgstr "La cible montée n'est pas une racine Linux valide."

#: src/boothelper.cpp:459
msgid "Cannot create a private repair mount directory."
msgstr "Impossible de créer un répertoire de montage privé pour la réparation."

#: src/boothelper.cpp:473
msgid "The selected root or subvolume is not the expected Linux system."
msgstr ""
"La racine ou le sous-volume sélectionné ne correspond pas au système Linux "
"attendu."

#: src/boothelper.cpp:499
msgid "chroot, mount and umount are required to repair another Linux root."
