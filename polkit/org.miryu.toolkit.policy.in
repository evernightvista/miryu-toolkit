<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Evernight Vista Team</vendor>
  <vendor_url>https://github.com/evernightvista</vendor_url>

  <action id="org.miryu.toolkit.install-wine">
    <description>Manage Wine support packages</description>
    <description xml:lang="zh_CN">管理 Wine 支持软件包</description>
    <description xml:lang="zh_TW">管理 Wine 支援軟體包</description>
    <description xml:lang="ja">Wine サポートパッケージを管理</description>
    <description xml:lang="de">Wine-Unterstützungspakete verwalten</description>
    <description xml:lang="ko">Wine 지원 패키지 관리</description>
    <description xml:lang="fr">Gérer les paquets de prise en charge de Wine</description>
    <message>安装Wine需要认证</message>
    <message xml:lang="zh_CN">安装Wine需要认证</message>
    <message xml:lang="zh_TW">安裝 Wine 需要認證</message>
    <message xml:lang="ja">Wine のインストールには認証が必要です</message>
    <message xml:lang="de">Für die Installation von Wine ist eine Authentifizierung erforderlich</message>
    <message xml:lang="ko">Wine 설치에는 인증이 필요합니다</message>
    <message xml:lang="fr">L'installation de Wine nécessite une authentification</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_FULL_LIBEXECDIR@/miryu-toolkit/miryu-toolkit-wine</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.miryu.toolkit.install-steam">
    <description>Manage Steam package</description>
    <description xml:lang="zh_CN">管理 Steam 软件包</description>
    <description xml:lang="zh_TW">管理 Steam 軟體包</description>
    <description xml:lang="ja">Steam パッケージを管理</description>
    <description xml:lang="de">Steam-Paket verwalten</description>
    <description xml:lang="ko">Steam 패키지 관리</description>
    <description xml:lang="fr">Gérer le paquet Steam</description>
    <message>安装Steam需要认证</message>
    <message xml:lang="zh_CN">安装Steam需要认证</message>
    <message xml:lang="zh_TW">安裝 Steam 需要認證</message>
    <message xml:lang="ja">Steam のインストールには認証が必要です</message>
    <message xml:lang="de">Für die Installation von Steam ist eine Authentifizierung erforderlich</message>
    <message xml:lang="ko">Steam 설치에는 인증이 필요합니다</message>
    <message xml:lang="fr">L'installation de Steam nécessite une authentification</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_FULL_LIBEXECDIR@/miryu-toolkit/miryu-toolkit-steam</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.miryu.toolkit.install-midi">
    <description>Manage MIDI playback support package</description>
    <description xml:lang="zh_CN">管理 MIDI 播放支持软件包</description>
    <description xml:lang="zh_TW">管理 MIDI 播放支援軟體包</description>
    <description xml:lang="ja">MIDI 再生サポートパッケージを管理</description>
    <description xml:lang="de">Paket für MIDI-Wiedergabeunterstützung verwalten</description>
    <description xml:lang="ko">MIDI 재생 지원 패키지 관리</description>
    <description xml:lang="fr">Gérer le paquet de prise en charge de la lecture MIDI</description>
    <message>安装MIDI播放需要认证</message>
    <message xml:lang="zh_CN">安装MIDI播放需要认证</message>
    <message xml:lang="zh_TW">安裝 MIDI 播放需要認證</message>
    <message xml:lang="ja">MIDI 再生サポートのインストールには認証が必要です</message>
    <message xml:lang="de">Für die Installation der MIDI-Wiedergabeunterstützung ist eine Authentifizierung erforderlich</message>
    <message xml:lang="ko">MIDI 재생 지원 설치에는 인증이 필요합니다</message>
    <message xml:lang="fr">L'installation de la prise en charge de la lecture MIDI nécessite une authentification</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_FULL_LIBEXECDIR@/miryu-toolkit/miryu-toolkit-midi</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.miryu.toolkit.install-extra-fonts">
