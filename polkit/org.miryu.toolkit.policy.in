  <action id="org.miryu.toolkit.apply-environment">
    <description>Apply system-wide environment variables</description>
    <description xml:lang="zh_CN">应用系统范围环境变量</description>
    <description xml:lang="zh_TW">套用系統範圍環境變數</description>
    <description xml:lang="ja">システム全体の環境変数を適用</description>
    <description xml:lang="de">Systemweite Umgebungsvariablen anwenden</description>
    <description xml:lang="ko">시스템 전체 환경 변수 적용</description>
    <description xml:lang="fr">Appliquer les variables d'environnement système</description>
    <message>应用系统范围环境变量需要认证</message>
    <message xml:lang="zh_CN">应用系统范围环境变量需要认证</message>
    <message xml:lang="zh_TW">套用系統範圍環境變數需要認證</message>
    <message xml:lang="ja">システム全体の環境変数の適用には認証が必要です</message>
    <message xml:lang="de">Zum Anwenden systemweiter Umgebungsvariablen ist eine Authentifizierung erforderlich</message>
    <message xml:lang="ko">시스템 전체 환경 변수를 적용하려면 인증이 필요합니다</message>
    <message xml:lang="fr">L'application des variables d'environnement système nécessite une authentification</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_FULL_LIBEXECDIR@/miryu-toolkit/miryu-toolkit-apply-environment</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.miryu.toolkit.restore-environment">
    <description>Restore default system-wide environment variables</description>
    <description xml:lang="zh_CN">恢复默认系统范围环境变量</description>
    <description xml:lang="zh_TW">恢復預設系統範圍環境變數</description>
    <description xml:lang="ja">既定のシステム全体の環境変数を復元</description>
    <description xml:lang="de">Standardwerte der systemweiten Umgebungsvariablen wiederherstellen</description>
    <description xml:lang="ko">기본 시스템 전체 환경 변수 복원</description>
    <description xml:lang="fr">Restaurer les variables d'environnement système par défaut</description>
    <message>恢复默认系统范围环境变量需要认证</message>
    <message xml:lang="zh_CN">恢复默认系统范围环境变量需要认证</message>
    <message xml:lang="zh_TW">恢復預設系統範圍環境變數需要認證</message>
    <message xml:lang="ja">既定のシステム全体の環境変数の復元には認証が必要です</message>
    <message xml:lang="de">Zum Wiederherstellen der Standardwerte der systemweiten Umgebungsvariablen ist eine Authentifizierung erforderlich</message>
    <message xml:lang="ko">기본 시스템 전체 환경 변수를 복원하려면 인증이 필요합니다</message>
    <message xml:lang="fr">La restauration des variables d'environnement système par défaut nécessite une authentification</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_FULL_LIBEXECDIR@/miryu-toolkit/miryu-toolkit-restore-environment</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.miryu.toolkit.cleanup-kernel">
